{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferry.dev/events/gateway/credential_health_changed.v1.event.json",
  "title": "CredentialHealthChanged",
  "description": "凭证健康状态变化后发布。state 为 cooling 或 failed 时必须携带 reason，state 为 cooling 时必须携带 recover_at。",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "description": "事件标识，全局唯一" },
    "source": { "type": "string", "description": "事件来源" },
    "type": { "const": "ferry.gateway.credential.health_changed.v1" },
    "subject": { "type": "string", "description": "受影响凭证的标识" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": {
      "type": "object",
      "required": ["credential_id", "state"],
      "properties": {
        "credential_id": { "type": "string" },
        "state": { "enum": ["ready", "cooling", "disabled", "failed"] },
        "reason": { "type": "string" },
        "recover_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
