{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferry.dev/events/gateway/credential_registered.v1.event.json",
  "title": "CredentialRegistered",
  "description": "凭证注册后发布，用于外部系统同步凭证目录。id 与 credential_health_changed、credential_deleted 共用同一标识。",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "description": "事件标识，全局唯一" },
    "source": { "type": "string", "description": "事件来源" },
    "type": { "const": "ferry.gateway.credential.registered.v1" },
    "subject": { "type": "string", "description": "受影响凭证的标识" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": {
      "type": "object",
      "required": ["credential_id", "name", "provider"],
      "properties": {
        "credential_id": { "type": "string" },
        "name": { "type": "string" },
        "provider": { "type": "string" }
      }
    }
  }
}
