{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferry.dev/events/gateway/credential_group_removed.v1.event.json",
  "title": "CredentialGroupRemoved",
  "description": "账号组移除后发布。组内最后一个凭证删除时触发，别名中指向该组的目标由别名侧清理。",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "description": "事件标识，全局唯一" },
    "source": { "type": "string", "description": "事件来源" },
    "type": { "const": "ferry.gateway.credential_group.removed.v1" },
    "subject": { "type": "string", "description": "被移除账号组的标识" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": {
      "type": "object",
      "required": ["group_id"],
      "properties": {
        "group_id": { "type": "string" }
      }
    }
  }
}
