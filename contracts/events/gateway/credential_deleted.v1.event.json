{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferry.dev/events/gateway/credential_deleted.v1.event.json",
  "title": "CredentialDeleted",
  "description": "凭证删除后发布，用于外部系统回收对应引用。",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "description": "事件标识，全局唯一" },
    "source": { "type": "string", "description": "事件来源" },
    "type": { "const": "ferry.gateway.credential.deleted.v1" },
    "subject": { "type": "string", "description": "被删除凭证的标识" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": {
      "type": "object",
      "required": ["credential_id"],
      "properties": {
        "credential_id": { "type": "string" }
      }
    }
  }
}
