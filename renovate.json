{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Asia/Shanghai",
  "schedule": ["after 6am and before 7am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "非主版本更新按生态分组并自动合并",
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "groupName": "all non-major ({{manager}})",
      "automerge": true
    },
    {
      "description": "digest 更新按生态分组并保留人工审查",
      "matchUpdateTypes": ["digest"],
      "groupName": "all digests ({{manager}})"
    },
    {
      "description": "GitHub Actions 主版本升级单独提 PR 逐个审查",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"]
    }
  ]
}
